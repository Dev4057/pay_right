# ============================================================
# Pay Right — backend environment
# Copy this file to backend/.env and fill in your own keys.
# NEVER commit .env — it is gitignored for a reason.
# ============================================================

# --- OpenAI (powers all four agents) ------------------------
# Free tier = 50 requests/day PER MODEL. If a bucket runs dry, rotate:
# gpt-5-mini <-> gpt-4.1-mini <-> gpt-4o-mini
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-5-mini
# Optional (sensible defaults):
# OPENAI_TIMEOUT_MS=120000
# OPENAI_REASONING_EFFORT=low

# --- Prava sandbox (from dashboard.prava.space) -------------
PRAVA_BACKEND_URL=https://sandbox.api.prava.space
PRAVA_SECRET_KEY=sk_test_your-secret-key
PRAVA_PUBLISHABLE_KEY=pk_test_your-publishable-key

# --- Rules layer (deterministic guardrails) -----------------
# Default spend ceiling; the dashboard slider overrides it per run.
WALLET_LIMIT_USD=30.00
# The agent's purchase mandate. Only "hosting" is supported.
ASSIGNED_CATEGORY=hosting

# --- Receipt email (optional — skipped gracefully if unset) -
# Gmail: create an App Password at myaccount.google.com/apppasswords
# (requires 2-Step Verification; paste WITHOUT spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your16charapppassword
# Optional From header (defaults to SMTP_USER):
# SMTP_FROM=Pay Right <you@gmail.com>

# --- Deploy rail (optional) ---------------------------------
# off     = deploy feature hidden
# dry-run = plan + narrate the exact Render API calls, execute NOTHING (default)
# live    = really provision on Render's FREE tier (demo day only)
DEPLOY_MODE=dry-run
# From dashboard.render.com -> Account Settings -> API Keys
RENDER_API_KEY=rnd_your-key-here
