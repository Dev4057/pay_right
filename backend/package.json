{
  "name": "pay-right-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Pre-Deployment Infrastructure Fit Agent — backend (analyzer agent, infra agent, rules layer, Prava payments)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
